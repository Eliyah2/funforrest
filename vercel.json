{
  "buildCommand": "sh tools/vercel-build.sh",
  "outputDirectory": "dist",
  "devCommand": "npx expo",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/_expo/static/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
