[TEMPLATE]
# Kopieer dit bestand naar  .env  en vul je Supabase-gegevens in.
# Dashboard > Project Settings > API
#
# Zonder deze waarden draait de app lokaal (opslag per apparaat).
EXPO_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Activatiecode voor het registreren (alleen gebruikt als Supabase uit staat).
# Leeg laten = registreren gesloten, alleen inloggen met bestaande accounts.
# Zet deze waarde nooit in een publieke repo en deel hem niet in een appje:
# deel liever per-gast-codes via het beheerscherm (werkt met Supabase).
EXPO_PUBLIC_ACCESS_CODE=
